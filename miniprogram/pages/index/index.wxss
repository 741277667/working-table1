fe-area-inset-bottom);display:flex;align-items:center;justify-content:space-around;background:#f1ecdf;border-top:1px solid #d4c9b4}.tabbar button{display:flex;flex-direction:column;align-items:center;gap:3px;width:25%;font-size:9px;letter-spacing:.05em;color:#8b8173}.tabbar button text:first-child{font-size:18px;line-height:20px}.tabbar button.active{color:#574d3f}.drag-hidden{opacity:.18}.drag-proxy{position:fixed;z-index:99;width:140px;min-height:74px;box-sizing:border-box;padding:12px;background:#f4efdf;border:1px solid #cfc3ad;box-shadow:2px 10px 18px #342a1e54;pointer-events:none;display:flex;flex-direction:column;justify-content:space-between;transition:transform 70ms ease-out}.drag-proxy>text:first-child{font:15px Georgia,"Songti SC",serif}.lift-mark{align-self:flex-end;font-size:8px;color:#8e806b}

